<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.caty.nightshift.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__NIGHTSHIFT_ROOT__/bin/nightshift-dispatch</string>
    <string>digest</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__NIGHTSHIFT_ROOT__/state/logs/launchd-digest.log</string>
  <key>StandardErrorPath</key>
  <string>__NIGHTSHIFT_ROOT__/state/logs/launchd-digest.log</string>
</dict>
</plist>
