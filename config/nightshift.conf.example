# Copy this file to config/nightshift.conf and edit it for the local host.

# NIGHTSHIFT_STATE_DIR="$REPO_ROOT/state"

# Observation lanes are contiguous numbered shell command strings starting at 1.
# The scan stops at the first missing LANE_CMD_n, so do not leave number gaps.
# Lanes write proposals to "$LANE_DIR/findings.jsonl"; they never write the ledger.
LANE_CMD_1=':'

LANE_TIMEBOX_MIN=60
# 0 means the run is metered but uncapped (the Phase 0 default).
NIGHT_BUDGET_TOKENS=0
BUDGET_PROBE_CMD="$REPO_ROOT/bin/budget-probe-stub"

# Daytime verdict-sync settings. These are not exported into lane processes.
NIGHT_BOT_LOGIN='night-bot'
VERDICT_GH_BIN='gh'

# Morning triage settings. These are not exported into lane processes.
# Defaults mirror docs/morning-triage.md §10.
# TRIAGE_REPORT_ISSUE must point at the pinned + locked execution-record Issue.
# TRIAGE_TARGET_REPOS uses "<ledger_repo>=<owner/name>" pairs.
TRIAGE_ENABLED=0
TRIAGE_ALREADY_FIXED_MODE='suggest'
TRIAGE_MAX_VERIFY_PER_RUN=25
TRIAGE_REVERIFY_INTERVAL_DAYS=7
TRIAGE_MAX_NEW_FOR_DEDUP=40
TRIAGE_VERIFY_BATCH=5
TRIAGE_DEDUP_BATCH=10
TRIAGE_CONCURRENCY=3
TRIAGE_LLM_TIMEOUT_SEC=300
TRIAGE_PHASE_A_DEADLINE_SEC=900
TRIAGE_HARD_WALL='06:58'
TRIAGE_DEDUP_POOL_MAX=150
TRIAGE_ADAPTER="$REPO_ROOT/lanes/review/adapters/codex.sh"
TRIAGE_REPORT_ISSUE=''
TRIAGE_TARGET_REPOS=''

# Colon-separated absolute paths exposed READ-WRITE through symlinks inside the
# isolated lane HOME. Metsuke and review seats require their matching CLI
# auth/config directory below.
# Sensitive basenames such as .ssh, .config, .git-credentials, .netrc, .aws,
# .gnupg, and .config/gh are refused even when configured.
# This retains model CLI authentication while lane-env writes a
# credential-neutral Git configuration. Do not add GitHub credential paths.
# Add $HOME/.claude here when opting into the experimental Opus seat.
LANE_HOME_LINKS="$HOME/.codex:$HOME/.kimi-code:$HOME/.grok"

# Shared model adapter binaries/config. Lane commands must embed the selected
# values because lane_exec does not inherit shell variables from this file.
REVIEW_CODEX_BIN='codex'
REVIEW_KIMI_BIN="$HOME/.kimi-code/bin/kimi"
REVIEW_GROK_BIN="$HOME/.grok/bin/grok"
REVIEW_OPUS_ENABLED=0
REVIEW_CLAUDE_BIN="$HOME/.claude/local/claude"
REVIEW_CLAUDE_CONFIG_DIR="$HOME/.claude"

# Metsuke UX observation lane. These values are embedded in LANE_CMD_1 because
# lane_exec intentionally starts with env -i and does not inherit config vars.
# Paths are operator-controlled shell config and must not contain single quotes.
METSUKE_TARGET_URL=''
METSUKE_LP_CHECKOUT='/absolute/path/to/caty-talk-LP'
METSUKE_PORT=4173
METSUKE_PERSONAS='beginner expert impatient'
PLAYWRIGHT_BROWSERS_PATH_REAL='/absolute/path/to/ms-playwright'
METSUKE_SEAT='codex'
METSUKE_CODEX_BIN="$REVIEW_CODEX_BIN"
# Supported seats are codex, kimi, grok, and experimental opus. GLM is excluded
# because its single-shot digest adapter cannot drive Metsuke persona flows.
# To rotate models across nights, let the operator choose METSUKE_SEAT using the
# review lane's #28 select-mode result; Metsuke intentionally has no second
# rotation engine. Opus also requires REVIEW_OPUS_ENABLED=1.
# LANE_CMD_1="METSUKE_TARGET_URL='$METSUKE_TARGET_URL' METSUKE_LP_CHECKOUT='$METSUKE_LP_CHECKOUT' METSUKE_PORT='$METSUKE_PORT' METSUKE_PERSONAS='$METSUKE_PERSONAS' PLAYWRIGHT_BROWSERS_PATH_REAL='$PLAYWRIGHT_BROWSERS_PATH_REAL' METSUKE_SEAT='$METSUKE_SEAT' METSUKE_CODEX_BIN='$METSUKE_CODEX_BIN' REVIEW_KIMI_BIN='$REVIEW_KIMI_BIN' REVIEW_GROK_BIN='$REVIEW_GROK_BIN' REVIEW_OPUS_ENABLED='$REVIEW_OPUS_ENABLED' REVIEW_CLAUDE_BIN='$REVIEW_CLAUDE_BIN' REVIEW_CLAUDE_CONFIG_DIR='$REVIEW_CLAUDE_CONFIG_DIR' /bin/bash '$REPO_ROOT/lanes/metsuke/run.sh'"

# Multimodel blind review observation lane. Opus is experimental and disabled
# unless REVIEW_OPUS_ENABLED=1. GLM reads its API key from a protected file;
# the key is never passed as an environment variable or command argument.
REVIEW_TARGET_SOURCE='/absolute/path/to/git-checkout'
REVIEW_SEAT_ROSTER='codex,kimi,glm,grok'
REVIEW_SEATS_PER_NIGHT=3
REVIEW_SEAT_TIMEOUT_SEC=900
REVIEW_CURL_BIN='/usr/bin/curl'
GLM_KEY_FILE='/absolute/path/to/glm-api-key'
REVIEW_GLM_MAX_TOKENS=4096
# LANE_CMD_2="REVIEW_TARGET_SOURCE='$REVIEW_TARGET_SOURCE' REVIEW_SEAT_ROSTER='$REVIEW_SEAT_ROSTER' REVIEW_SEATS_PER_NIGHT='$REVIEW_SEATS_PER_NIGHT' REVIEW_SEAT_TIMEOUT_SEC='$REVIEW_SEAT_TIMEOUT_SEC' REVIEW_OPUS_ENABLED='$REVIEW_OPUS_ENABLED' REVIEW_CODEX_BIN='$REVIEW_CODEX_BIN' REVIEW_KIMI_BIN='$REVIEW_KIMI_BIN' REVIEW_GROK_BIN='$REVIEW_GROK_BIN' REVIEW_CURL_BIN='$REVIEW_CURL_BIN' REVIEW_CLAUDE_BIN='$REVIEW_CLAUDE_BIN' REVIEW_CLAUDE_CONFIG_DIR='$REVIEW_CLAUDE_CONFIG_DIR' GLM_KEY_FILE='$GLM_KEY_FILE' REVIEW_GLM_MAX_TOKENS='$REVIEW_GLM_MAX_TOKENS' /bin/bash '$REPO_ROOT/lanes/review/run.sh'"
# Rotation variant: mirror directory names must equal their GitHub repository
# names so the review lane emits the correct findings repo field. Use
# whitespace-free paths to non-bare worktree clones. Before enabling rotation,
# run `mkdir -p "$REPO_ROOT/state/lanes"`: rotate.sh does not create this state
# parent. Write-ahead means a same-night rerun consumes its next slot; a
# permanently missing mirror burns one slot and fails once per rotation cycle.
# LANE_CMD_2="REVIEW_ROTATION_TARGETS='caty-agent-harness=/abs/mirrors/caty-agent-harness sitter=/abs/mirrors/sitter ...' REVIEW_ROTATION_STATE='$REPO_ROOT/state/lanes/review-rotation.json' REVIEW_ROTATION_REFRESH=1 REVIEW_SEAT_ROSTER='$REVIEW_SEAT_ROSTER' REVIEW_SEATS_PER_NIGHT='$REVIEW_SEATS_PER_NIGHT' REVIEW_SEAT_TIMEOUT_SEC='$REVIEW_SEAT_TIMEOUT_SEC' REVIEW_OPUS_ENABLED='$REVIEW_OPUS_ENABLED' REVIEW_CODEX_BIN='$REVIEW_CODEX_BIN' REVIEW_KIMI_BIN='$REVIEW_KIMI_BIN' REVIEW_GROK_BIN='$REVIEW_GROK_BIN' REVIEW_CURL_BIN='$REVIEW_CURL_BIN' REVIEW_CLAUDE_BIN='$REVIEW_CLAUDE_BIN' REVIEW_CLAUDE_CONFIG_DIR='$REVIEW_CLAUDE_CONFIG_DIR' GLM_KEY_FILE='$GLM_KEY_FILE' REVIEW_GLM_MAX_TOKENS='$REVIEW_GLM_MAX_TOKENS' /bin/bash '$REPO_ROOT/lanes/review/rotate.sh'"

# Generic health lane: number it AFTER the review rotation lane. This example
# assumes rotation is LANE_CMD_1 (move the rotation command above to that slot).
# Settings must be embedded in LANE_CMD because lanes run under env -i.
# HEALTH_TARGET_SOURCE='/absolute/path/to/non-bare-checkout' overrides rotation.
# HEALTH_TEST_CMD / HEALTH_SUITE_GLOB override runner detection; choose only one.
# HEALTH_ROTATION_LANE='lane_1'
# HEALTH_ROTATION_STATE="$REPO_ROOT/state/lanes/review-rotation.json"
# HEALTH_TIMEBOX_SEC=1800
# LANE_CMD_2="HEALTH_ROTATION_LANE='$HEALTH_ROTATION_LANE' HEALTH_ROTATION_STATE='$HEALTH_ROTATION_STATE' HEALTH_TIMEBOX_SEC='$HEALTH_TIMEBOX_SEC' /bin/bash '$REPO_ROOT/lanes/health/run.sh'"

# Org-wide public consistency lane. LANE_CMD numbers must remain contiguous:
# the dispatcher stops scanning at the first missing LANE_CMD_n. Its anonymous
# GitHub API reads share the 60 requests/hour/IP allowance with other tools.
# All OC_* values are embedded here
# because lane_exec starts the command under env -i.
# Daytime digest freshness sensor:
# set OC_FRESHNESS_ENFORCE=1 when LANE_CMD_3 is enabled so the digest warns if
# org-consistency stops publishing reports. OC_REPORT_DIR defaults to
# "$REPO_ROOT/state/org-consistency/report". OC_REPORT_MAX_AGE_DAYS must stay a
# positive integer; the digest fails closed when it is invalid.
OC_FRESHNESS_ENFORCE=0
# OC_REPORT_DIR="$NIGHTSHIFT_STATE_DIR/org-consistency/report"
OC_REPORT_MAX_AGE_DAYS=3
OC_SUGGEST_REPO='caty-ai/alpha-nightshift-dev'
# Layer-2 starts one read-only seat per repository for OC-E/F/G and a separate
# seat for OC-H. Each invocation receives its prompt on stdin from a scratch cwd.
# Layer-3 runs weekly from NIGHT_ID: OC_L3_WEEKDAY is the ISO weekday (1=Monday,
# 7=Sunday), and OC_L3_MAX_REPOS caps the attempt-based least-recently-run
# rotation. A single per-repository seat bundles OC-I (the vendored numbered
# README gate) and OC-J (the first-30-seconds score); only OC-J scores 1 or 2
# become findings. ij_night records every attempt while ij_head advances only
# after a valid, fresh result, so a failing repository cannot pin the rotation.
# OC_PROMPT_MAX_BYTES bounds each rendered layer-2/layer-3 prompt (default
# 262144). Oversized cells are NOT-RUN(prompt-too-large), remain retryable, and
# do not consume their successful HEAD audit.
# Because lane_exec uses env -i, set OC_SEAT_TIMEOUT_SEC only inside LANE_CMD_3.
# OC_SEAT_CMD='codex exec --sandbox read-only --ignore-rules --ignore-user-config --ephemeral --disable multi_agent --skip-git-repo-check -'
# LANE_CMD_3="OC_STATE_DIR='$REPO_ROOT/state/org-consistency' OC_L2_MAX_REPOS=3 OC_H_MAX_REPOS=2 OC_L3_MAX_REPOS=3 OC_L3_WEEKDAY=7 OC_PROMPT_MAX_BYTES=262144 OC_EXCLUDE_REPOS='' OC_LANG_POLICY=4 OC_AGENT_DOC_GLOBS='' OC_LEFT_SCOPE_WINDOW_NIGHTS=30 OC_ZERO_STREAK_NIGHTS=5 OC_STALE_ESCALATE_NIGHTS=3 OC_SUGGEST_REPO='caty-ai/alpha-nightshift-dev' OC_SEAT_TIMEOUT_SEC=900 OC_SEAT_CMD='codex exec --sandbox read-only --ignore-rules --ignore-user-config --ephemeral --disable multi_agent --skip-git-repo-check -' /bin/bash '$REPO_ROOT/lanes/org-consistency/run.sh'"
