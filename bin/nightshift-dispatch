#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

# shellcheck source=../lib/common.sh
. "$REPO_ROOT/lib/common.sh"
nightshift_init "$REPO_ROOT"

# shellcheck source=../lib/lock.sh
. "$REPO_ROOT/lib/lock.sh"
# shellcheck source=../lib/ledger.sh
. "$REPO_ROOT/lib/ledger.sh"
# shellcheck source=../lib/budget.sh
. "$REPO_ROOT/lib/budget.sh"
# shellcheck source=../lib/lane-env.sh
. "$REPO_ROOT/lib/lane-env.sh"
# shellcheck source=../lib/digest.sh
. "$REPO_ROOT/lib/digest.sh"

usage() {
  printf 'Usage: %s {run|digest|status}\n' "$0" >&2
}

append_event() {
  event_type=$1
  event_json=$(jq -n -c \
    --arg ts "$(nightshift_iso_now)" \
    --arg night_id "$NIGHT_ID" \
    --arg type "$event_type" \
    '{ts: $ts, night_id: $night_id, type: $type}')
  if ! ledger_append "$event_json"; then
    return 1
  fi
}

record_skip() {
  skip_reason=$1
  skip_record=$(jq -n -c \
    --arg ts "$(nightshift_iso_now)" \
    --arg night_id "$NIGHT_ID" \
    --arg reason "$skip_reason" \
    '{ts: $ts, night_id: $night_id, type: "skip", reason: $reason}')
  if ! ledger_append "$skip_record"; then
    return 1
  fi
}

run_end_already_recorded_in_ledger() {
  run_ledger=$(ledger_file_path)
  [ -f "$run_ledger" ] || return 1
  if ! run_record_counts=$(jq -s -r --arg night_id "$NIGHT_ID" '
    [
      ([.[] | select(.night_id == $night_id and .type == "run_start")] | length),
      ([.[] | select(.night_id == $night_id and .type == "run_end")] | length)
    ]
    | @tsv
  ' "$run_ledger" 2>/dev/null); then
    return 1
  fi
  set -- $run_record_counts
  [ "${1:-0}" -gt 0 ] && [ "${2:-0}" -ge "$1" ]
}

write_run_end() {
  run_lanes=$1
  run_findings=$2
  run_started_epoch=$3
  if [ "${RUN_END_RECORDED:-false}" = true ]; then
    return 0
  fi
  if run_end_already_recorded_in_ledger; then
    RUN_END_RECORDED=true
    return 0
  fi
  run_wallclock=$(( $(date '+%s') - run_started_epoch ))
  run_budget=$(budget_snapshot)
  run_end_record=$(jq -n -c \
    --arg ts "$(nightshift_iso_now)" \
    --arg night_id "$NIGHT_ID" \
    --argjson lanes_run "$run_lanes" \
    --argjson findings_count "$run_findings" \
    --argjson wallclock_sec "$run_wallclock" \
    --argjson budget "$run_budget" \
    '{
      ts: $ts,
      night_id: $night_id,
      type: "run_end",
      lanes_run: $lanes_run,
      findings_count: $findings_count,
      wallclock_sec: $wallclock_sec,
      budget: $budget
    }')
  if ! ledger_append "$run_end_record"; then
    return 1
  fi
  RUN_END_RECORDED=true
}

write_aborted_run_end() {
  run_lanes=$1
  run_findings=$2
  run_started_epoch=$3
  run_signal=$4
  abort_reason=$5
  if [ "${RUN_END_RECORDED:-false}" = true ]; then
    return 0
  fi
  if run_end_already_recorded_in_ledger; then
    RUN_END_RECORDED=true
    return 0
  fi
  run_wallclock=$(( $(date '+%s') - run_started_epoch ))
  run_budget=$(budget_snapshot)
  abort_record=$(jq -n -c \
    --arg ts "$(nightshift_iso_now)" \
    --arg night_id "$NIGHT_ID" \
    --arg signal "$run_signal" \
    --arg reason "$abort_reason" \
    --argjson lanes_run "$run_lanes" \
    --argjson findings_count "$run_findings" \
    --argjson wallclock_sec "$run_wallclock" \
    --argjson budget "$run_budget" \
    '{
      ts: $ts,
      night_id: $night_id,
      type: "run_end",
      aborted: true,
      lanes_run: $lanes_run,
      findings_count: $findings_count,
      wallclock_sec: $wallclock_sec,
      budget: $budget
    }
    + (if $signal == "" then {} else {signal: $signal} end)
    + (if $reason == "" then {} else {reason: $reason} end)')
  if ! ledger_append "$abort_record"; then
    return 1
  fi
  RUN_END_RECORDED=true
}

abort_after_ledger_failure() {
  failed_record_type=$1
  trap - HUP INT TERM USR1
  nightshift_log ERROR "Ledger append failed for $failed_record_type; aborting run"
  if [ "$RUN_START_RECORDED" = true ]; then
    if ! write_aborted_run_end \
      "$RUN_LANES_RUN" \
      "$RUN_FINDINGS_COUNT" \
      "$RUN_STARTED_EPOCH" \
      "" \
      "ledger_append_failed"; then
      nightshift_log ERROR "Best-effort abort record append also failed"
    fi
  fi
  return 1
}

stop_active_runtime() {
  if [ -n "${NIGHTSHIFT_ACTIVE_LANE_PID:-}" ]; then
    nightshift_stop_process_tree \
      "$NIGHTSHIFT_ACTIVE_LANE_PID" \
      "${NIGHTSHIFT_ACTIVE_LANE_DESCENDANTS:-}"
    NIGHTSHIFT_ACTIVE_LANE_PID=
    NIGHTSHIFT_ACTIVE_LANE_DESCENDANTS=
  fi
  if [ -n "${NIGHTSHIFT_ACTIVE_PROBE_PID:-}" ]; then
    nightshift_stop_process_tree \
      "$NIGHTSHIFT_ACTIVE_PROBE_PID" \
      "${NIGHTSHIFT_ACTIVE_PROBE_DESCENDANTS:-}"
    NIGHTSHIFT_ACTIVE_PROBE_PID=
    NIGHTSHIFT_ACTIVE_PROBE_DESCENDANTS=
  fi
  if [ -n "${NIGHTSHIFT_ACTIVE_BUDGET_TMP_DIR:-}" ] &&
    [ -d "$NIGHTSHIFT_ACTIVE_BUDGET_TMP_DIR" ]; then
    rm -rf "$NIGHTSHIFT_ACTIVE_BUDGET_TMP_DIR"
  fi
  NIGHTSHIFT_ACTIVE_BUDGET_TMP_DIR=
}

abort_infrastructure_run() {
  infrastructure_reason=$1
  trap - HUP INT TERM USR1
  stop_active_runtime
  nightshift_log ERROR "Infrastructure failure: $infrastructure_reason"
  if [ "$RUN_START_RECORDED" = true ]; then
    if ! write_aborted_run_end \
      "$RUN_LANES_RUN" \
      "$RUN_FINDINGS_COUNT" \
      "$RUN_STARTED_EPOCH" \
      "" \
      "$infrastructure_reason"; then
      nightshift_log ERROR "Failed to append infrastructure abort record"
    fi
  fi
  return 1
}

run_signal_handler() {
  caught_signal=$1
  signal_exit=$2
  # Ignore repeat delivery while cleanup is in progress. In a process-group
  # signal, the child receives the original signal and the supervisor may
  # forward the same signal before noticing that cleanup has started.
  trap '' HUP INT TERM USR1
  NIGHTSHIFT_PROCESS_INSPECTION_FAILED=false
  stop_active_runtime
  signal_abort_reason=
  if [ "$NIGHTSHIFT_PROCESS_INSPECTION_FAILED" = true ]; then
    signal_abort_reason=process_inspection_unavailable
  fi
  if [ "$RUN_START_RECORDED" = true ]; then
    if ! write_aborted_run_end \
      "$RUN_LANES_RUN" \
      "$RUN_FINDINGS_COUNT" \
      "$RUN_STARTED_EPOCH" \
      "$caught_signal" \
      "$signal_abort_reason"; then
      nightshift_log ERROR "Failed to append signal abort record"
    fi
  fi
  nightshift_log WARN "Run aborted by signal $caught_signal"
  exit "$signal_exit"
}

run_command() {
  lock_dir="$STATE_DIR/locks/nightshift.lock"
  lock_rc=0
  lock_acquire "$lock_dir" || lock_rc=$?
  if [ "$lock_rc" -ne 0 ]; then
    case "$lock_rc" in
      1)
        # This is the one sanctioned append by a non-lock-holder. A single
        # compact O_APPEND write makes true lock contention visible.
        if ! record_skip lock_held; then
          nightshift_log ERROR "Failed to record lock-held skip"
          return 1
        fi
        nightshift_log INFO "Skipped: already running (lock retained for human inspection)"
        return 0
        ;;
      *)
        if ! record_skip lock_error; then
          nightshift_log ERROR "Lock acquisition failed and lock_error could not be recorded"
          return 1
        fi
        nightshift_log ERROR "Lock acquisition failed without an existing lock"
        return 1
        ;;
    esac
  fi
  trap 'lock_release "$lock_dir" || true' EXIT

  RUN_STARTED_EPOCH=$(date '+%s')
  RUN_LANES_RUN=0
  RUN_FINDINGS_COUNT=0
  RUN_START_RECORDED=false
  RUN_END_RECORDED=false
  trap 'run_signal_handler HUP 129' HUP
  trap 'run_signal_handler INT 130' INT
  trap 'run_signal_handler TERM 143' TERM
  trap 'run_signal_handler INT 130' USR1

  if ! append_event run_start; then
    nightshift_log ERROR "Ledger append failed for run_start; no lanes started"
    trap - HUP INT TERM USR1
    return 1
  fi
  RUN_START_RECORDED=true
  nightshift_log INFO "Run started for night $NIGHT_ID"

  initial_budget_rc=0
  budget_check || initial_budget_rc=$?
  if [ "$initial_budget_rc" -ne 0 ]; then
    case "$initial_budget_rc" in
      2)
        if ! record_skip budget_exhausted; then
          abort_after_ledger_failure skip || true
          trap - HUP INT TERM USR1
          return 1
        fi
        nightshift_log INFO "No lanes started: budget exhausted"
        ;;
      3)
        abort_after_ledger_failure meter_error || true
        trap - HUP INT TERM USR1
        return 1
        ;;
      *)
        if ! record_skip meter_error; then
          abort_after_ledger_failure skip || true
          trap - HUP INT TERM USR1
          return 1
        fi
        nightshift_log WARN "No lanes started: budget meter error"
        abort_infrastructure_run "meter_error" || true
        return 1
        ;;
    esac
    if ! write_run_end "$RUN_LANES_RUN" "$RUN_FINDINGS_COUNT" "$RUN_STARTED_EPOCH"; then
      abort_after_ledger_failure run_end || true
      return 1
    fi
    trap - HUP INT TERM USR1
    return 0
  fi

  lane_number=1
  while :; do
    lane_var="LANE_CMD_$lane_number"
    if ! declare -p "$lane_var" >/dev/null 2>&1; then
      break
    fi
    lane_command=${!lane_var}
    if [ -z "$lane_command" ]; then
      lane_number=$((lane_number + 1))
      continue
    fi

    lane_budget_rc=0
    budget_check || lane_budget_rc=$?
    if [ "$lane_budget_rc" -ne 0 ]; then
      case "$lane_budget_rc" in
        2)
          if ! record_skip budget_exhausted; then
            abort_after_ledger_failure skip || true
            trap - HUP INT TERM USR1
            return 1
          fi
          nightshift_log INFO "Stopping before lane $lane_number: budget exhausted"
          ;;
        3)
          abort_after_ledger_failure meter_error || true
          trap - HUP INT TERM USR1
          return 1
          ;;
        *)
          if ! record_skip meter_error; then
            abort_after_ledger_failure skip || true
            trap - HUP INT TERM USR1
            return 1
          fi
          nightshift_log WARN "Stopping before lane $lane_number: budget meter error"
          abort_infrastructure_run "meter_error" || true
          return 1
          ;;
      esac
      break
    fi

    lane_name="lane_$lane_number"
    lane_dir="$STATE_DIR/lanes/$NIGHT_ID/$lane_name"
    if ! mkdir -p "$lane_dir"; then
      abort_infrastructure_run "lane_directory_failed" || true
      return 1
    fi
    lane_start_record=$(jq -n -c \
      --arg ts "$(nightshift_iso_now)" \
      --arg night_id "$NIGHT_ID" \
      --arg lane "$lane_name" \
      '{ts: $ts, night_id: $night_id, type: "lane_start", lane: $lane}')
    if ! ledger_append "$lane_start_record"; then
      abort_after_ledger_failure lane_start || true
      trap - HUP INT TERM USR1
      return 1
    fi
    RUN_LANES_RUN=$((RUN_LANES_RUN + 1))
    nightshift_log INFO "Starting $lane_name"

    lane_exec_rc=0
    lane_exec "$lane_dir" /bin/bash -c "$lane_command" || lane_exec_rc=$?
    if [ "$lane_exec_rc" -ne 0 ]; then
      abort_infrastructure_run "lane_setup_failed" || true
      return 1
    fi
    if ! ledger_ingest_proposals "$lane_dir/findings.jsonl"; then
      abort_after_ledger_failure finding || true
      trap - HUP INT TERM USR1
      return 1
    fi
    RUN_FINDINGS_COUNT=$((RUN_FINDINGS_COUNT + LEDGER_INGESTED_COUNT))

    lane_end_record=$(jq -n -c \
      --arg ts "$(nightshift_iso_now)" \
      --arg night_id "$NIGHT_ID" \
      --arg lane "$lane_name" \
      --argjson exit_code "$LANE_EXIT_CODE" \
      --argjson timed_out "$LANE_TIMED_OUT" \
      --argjson wallclock_sec "$LANE_WALLCLOCK_SEC" \
      --argjson survivors "$LANE_SURVIVORS_JSON" \
      --argjson process_inspection_failed "$LANE_PROCESS_INSPECTION_FAILED" \
      --argjson lifecycle_violation "$LANE_LIFECYCLE_VIOLATION" \
      --argjson findings_ingested "$LEDGER_INGESTED_COUNT" \
      --argjson malformed_proposals "$LEDGER_SKIPPED_COUNT" \
      --argjson duplicates_skipped "$LEDGER_DUPLICATE_COUNT" \
      '{
        ts: $ts,
        night_id: $night_id,
        type: "lane_end",
        lane: $lane,
        exit_code: $exit_code,
        timed_out: $timed_out,
        wallclock_sec: $wallclock_sec,
        survivors: $survivors,
        process_inspection_failed: $process_inspection_failed,
        lifecycle_violation: $lifecycle_violation,
        findings_ingested: $findings_ingested,
        malformed_proposals: $malformed_proposals,
        duplicates_skipped: $duplicates_skipped
      }')
    if ! ledger_append "$lane_end_record"; then
      abort_after_ledger_failure lane_end || true
      trap - HUP INT TERM USR1
      return 1
    fi
    nightshift_log INFO "Finished $lane_name (exit=$LANE_EXIT_CODE timed_out=$LANE_TIMED_OUT findings=$LEDGER_INGESTED_COUNT duplicates=$LEDGER_DUPLICATE_COUNT)"
    if ! printf '%s\n' "$LANE_SURVIVORS_JSON" |
      jq -e 'type == "array" and length == 0' >/dev/null; then
      abort_infrastructure_run "lane_survivors" || true
      return 1
    fi
    if [ "$LANE_PROCESS_INSPECTION_FAILED" = true ]; then
      abort_infrastructure_run "lane_process_inspection_unavailable" || true
      return 1
    fi
    if [ "$LANE_LIFECYCLE_VIOLATION" = true ]; then
      abort_infrastructure_run "lane_lifecycle_violation" || true
      return 1
    fi
    lane_number=$((lane_number + 1))
  done

  if ! write_run_end "$RUN_LANES_RUN" "$RUN_FINDINGS_COUNT" "$RUN_STARTED_EPOCH"; then
    abort_after_ledger_failure run_end || true
    return 1
  fi
  trap - HUP INT TERM USR1
  nightshift_log INFO "Run ended (lanes=$RUN_LANES_RUN findings=$RUN_FINDINGS_COUNT)"
}

digest_command() {
  if ! all_current_findings=$(ledger_project_findings); then
    nightshift_log ERROR "Cannot render digest from malformed ledger history"
    return 1
  fi
  if ! kpi_block=$(printf '%s\n' "$all_current_findings" |
    digest_kpi_block); then
    nightshift_log ERROR "Cannot calculate cumulative verdict KPI"
    return 1
  fi

  run_start_count=$(ledger_query_night "$NIGHT_ID" run_start | wc -l | tr -d ' ')
  run_end_count=$(ledger_query_night "$NIGHT_ID" run_end | wc -l | tr -d ' ')
  finding_count=$(ledger_query_night "$NIGHT_ID" finding | wc -l | tr -d ' ')
  last_run_end=$(ledger_query_night "$NIGHT_ID" run_end | tail -n 1)
  last_skip=$(ledger_query_night "$NIGHT_ID" skip | tail -n 1)
  lock_skip_count=$(ledger_query_night "$NIGHT_ID" skip |
    jq -r 'select(.reason == "lock_held") | .reason' |
    wc -l |
    tr -d ' ')

  if [ -n "$last_run_end" ]; then
    budget_block=$(printf '%s\n' "$last_run_end" | jq -c \
      '.budget // {"status":"unavailable"}')
    lane_stats=$(printf '%s\n' "$last_run_end" | jq -r \
      '"lanes_run=\(.lanes_run // 0), findings=\(.findings_count // 0), wallclock_sec=\(.wallclock_sec // 0)"')
  else
    budget_block='{"status":"unavailable"}'
    lane_stats='lanes_run=unknown, findings=unknown, wallclock_sec=unknown'
  fi

  if [ "$run_start_count" -eq 0 ]; then
    if [ "$lock_skip_count" -gt 0 ]; then
      digest_mode=LOCK_HELD
      findings_block='ロック残留のため skip — 人間によるロック確認が必要'
      lane_stats='run_start=0, lanes_run=0, skip_reason=lock_held'
      digest_dead_man=false
    else
      digest_mode=DEAD_MAN
      findings_block='夜番は起きなかった'
      lane_stats='run_start=0, lanes_run=unknown, findings=unknown'
      digest_dead_man=true
    fi
  elif [ "$run_end_count" -lt "$run_start_count" ] ||
    [ "$(printf '%s\n' "$last_run_end" | jq -r '.aborted == true')" = true ]; then
    digest_mode=ABORTED
    findings_block='夜番は開始しましたが、中断されました。run_end または aborted 記録を確認してください。'
    if [ "$run_end_count" -lt "$run_start_count" ]; then
      lane_stats="run_start=$run_start_count, run_end=$run_end_count, lanes_run=unknown, findings=unknown"
    fi
    digest_dead_man=false
  elif [ "$(printf '%s\n' "$last_run_end" | jq -r '.lanes_run // 0')" -eq 0 ] &&
    [ -n "$last_skip" ]; then
    skip_reason=$(printf '%s\n' "$last_skip" | jq -r '.reason // "unknown"')
    digest_mode=SKIPPED
    findings_block="夜番は skip されました。理由: $skip_reason"
    lane_stats="lanes_run=0, findings=0, skip_reason=$skip_reason"
    digest_dead_man=false
  elif [ "$finding_count" -eq 0 ]; then
    digest_mode=ZERO
    findings_block='夜番は起動し、観測項目は0件でした。'
    digest_dead_man=false
  else
    digest_mode=NORMAL
    findings_block=$(printf '%s\n' "$all_current_findings" |
      jq -r --arg night_id "$NIGHT_ID" '
        select(
          .night_id == $night_id and
          (
            .current_status == "open" or
            .current_status == "adopted" or
            .current_status == "regression"
          )
        )
        | "- [" + .current_status + "] " +
          (.symptom | gsub("[\\r\\n\\t]+"; " ")) +
          "（確認: " + .confirm_cost + "）"
      ')
    if [ -z "$findings_block" ]; then
      findings_block='現在対応可能な観測項目はありません。'
    fi
    digest_dead_man=false
  fi

  oc_freshness_enforce=${OC_FRESHNESS_ENFORCE:-0}
  oc_report_dir=${OC_REPORT_DIR:-"$STATE_DIR/org-consistency/report"}
  oc_report_max_age_days=${OC_REPORT_MAX_AGE_DAYS:-3}
  if ! org_consistency_freshness=$(digest_org_consistency_freshness \
    "$oc_freshness_enforce" \
    "$oc_report_dir" \
    "$oc_report_max_age_days" \
    "$(date '+%s')"); then
    nightshift_log ERROR "Cannot evaluate org-consistency digest freshness"
    return 1
  fi

  lane_status_cmd=${LANE_STATUS_CMD:-}
  lane_status_timeout_sec=${LANE_STATUS_TIMEOUT_SEC:-120}
  lane_status_max_rows=${LANE_STATUS_MAX_ROWS:-10}
  if ! digest_lane_status_validate_config \
    "$lane_status_timeout_sec" "$lane_status_max_rows"; then
    nightshift_log ERROR "Cannot configure lane status digest section"
    return 1
  fi
  digest_lane_status_block \
    "$lane_status_cmd" \
    "$lane_status_timeout_sec" \
    "$lane_status_max_rows" \
    "$STATE_DIR/digests/$NIGHT_ID"

  lane_artifacts=$(digest_lane_artifacts_block "$STATE_DIR/lanes/$NIGHT_ID")
  generated_at=$(nightshift_iso_now)
  digest_file="$STATE_DIR/digests/$NIGHT_ID.md"
  if ! digest_render_template \
    "$REPO_ROOT/templates/digest.md" \
    "$digest_file" \
    "$NIGHT_ID" \
    "$generated_at" \
    "$digest_mode" \
    "$findings_block" \
    "$budget_block" \
    "$lane_stats" \
    "$kpi_block" \
    "$org_consistency_freshness" \
    "$DIGEST_LANE_STATUS_SECTION" \
    "$DIGEST_LANE_STATUS_FOOTER" \
    "$lane_artifacts"; then
    nightshift_log ERROR "Failed to write digest: $digest_file"
    return 1
  fi

  digest_record=$(jq -n -c \
    --arg ts "$generated_at" \
    --arg night_id "$NIGHT_ID" \
    --arg path "$digest_file" \
    --arg mode "$digest_mode" \
    --argjson dead_man "$digest_dead_man" \
    '{
      ts: $ts,
      night_id: $night_id,
      type: "digest_written",
      path: $path,
      mode: $mode,
      dead_man: $dead_man
    }')
  if ! ledger_append "$digest_record"; then
    nightshift_log ERROR "Digest was written, but digest_written ledger append failed"
    return 1
  fi
  nightshift_log INFO "Digest written: $digest_file ($digest_mode)"
}

status_command() {
  lock_dir="$STATE_DIR/locks/nightshift.lock"
  if [ -d "$lock_dir" ]; then
    printf 'lock: held\n'
    if [ -f "$lock_dir/meta" ]; then
      sed 's/^/  /' "$lock_dir/meta"
    fi
  else
    printf 'lock: free\n'
  fi

  ledger_file=$(ledger_file_path)
  if [ -f "$ledger_file" ]; then
    last_run_end=$(jq -c 'select(type == "object" and .type == "run_end")' "$ledger_file" | tail -n 1)
    ledger_lines=$(wc -l < "$ledger_file" | tr -d ' ')
  else
    last_run_end=
    ledger_lines=0
  fi
  printf 'last_run_end: %s\n' "${last_run_end:-none}"
  printf 'ledger_lines: %s\n' "$ledger_lines"
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

nightshift_prepare_state
nightshift_start_logging "$1"

dispatch_subcommand() {
  case "$1" in
    run) run_command ;;
    digest) digest_command ;;
    status) status_command ;;
    *) usage; return 2 ;;
  esac
}

NIGHTSHIFT_DISPATCH_PID=
supervisor_signal_handler() {
  supervisor_signal=$1
  supervisor_exit=$2
  trap '' HUP INT TERM
  if [ -n "$NIGHTSHIFT_DISPATCH_PID" ]; then
    case "$supervisor_signal" in
      INT) supervisor_forward_signal=USR1 ;;
      *) supervisor_forward_signal=$supervisor_signal ;;
    esac
    kill -"$supervisor_forward_signal" "$NIGHTSHIFT_DISPATCH_PID" 2>/dev/null || true
    wait "$NIGHTSHIFT_DISPATCH_PID" 2>/dev/null || true
    NIGHTSHIFT_DISPATCH_PID=
  fi
  set +e
  nightshift_finish_logging "$supervisor_exit"
  supervisor_finish_exit=$?
  set -e
  exit "$supervisor_finish_exit"
}

trap 'supervisor_signal_handler HUP 129' HUP
trap 'supervisor_signal_handler INT 130' INT
trap 'supervisor_signal_handler TERM 143' TERM

(
  set -e
  # POSIX asynchronous-list children may inherit SIGINT ignored. Install a
  # trappable relay before dispatch can acquire the run lock; run_command
  # replaces this with its full cleanup handler before recording run_start.
  trap 'exit 130' USR1
  dispatch_subcommand "$1"
) &
NIGHTSHIFT_DISPATCH_PID=$!
set +e
while kill -0 "$NIGHTSHIFT_DISPATCH_PID" 2>/dev/null; do
  sleep 0.05
done
wait "$NIGHTSHIFT_DISPATCH_PID"
dispatch_exit=$?
set -e
NIGHTSHIFT_DISPATCH_PID=
trap - HUP INT TERM

set +e
nightshift_finish_logging "$dispatch_exit"
finish_exit=$?
set -e
exit "$finish_exit"
