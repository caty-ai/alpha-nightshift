#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

# shellcheck source=../lib/common.sh disable=SC1091
. "$REPO_ROOT/lib/common.sh"
nightshift_init "$REPO_ROOT"

# shellcheck source=../lib/lock.sh disable=SC1091
. "$REPO_ROOT/lib/lock.sh"

oc_suggest_usage() {
  cat <<'EOF' >&2
usage: oc-suggest [--state-dir DIR] [--report-max-age-days N] [--promote FP] [list]
       oc-suggest [--state-dir DIR] [--report-max-age-days N] file FP...
EOF
}

oc_suggest_log() {
  printf '%s\n' "oc-suggest: $*" >&2
}

oc_suggest_die() {
  oc_suggest_log "$*"
  exit 2
}

oc_suggest_require_positive_int() {
  value=$1
  name=$2
  case "$value" in
    ''|*[!0-9]*|0) oc_suggest_die "$name must be a positive integer" ;;
  esac
}

oc_suggest_sanitize_claim() {
  /usr/bin/python3 - "$1" <<'PY'
import re
import sys

text = sys.argv[1]
text = re.sub(r'<!--.*?-->', '', text, flags=re.S)
text = re.sub(r'(?im)^\s{0,3}(?:```+|~~~+)\s*$', '', text)
text = re.sub(r'(?im)^\s{0,3}#{1,6}\s*', '', text)
text = re.sub(r'(?im)^\s*oc-fingerprint\s*:\s*.*$', '', text)
text = re.sub(r'(?i)oc-fingerprint\s*:\s*[^ \n\r\t]+', '', text)
text = re.sub(r'@\S+', '', text)
text = re.sub(r'#\d+', '', text)
text = re.sub(r'[ \t]+\n', '\n', text)
text = re.sub(r'\n{3,}', '\n\n', text)
text = text.replace('```', '').replace('~~~', '')
text = text.strip()
if not text:
    text = '(claim removed by sanitization)'
text = text[:500]
sys.stdout.write(text)
PY
}

oc_suggest_sanitize_field() {
  sanitized_field=$(oc_suggest_sanitize_claim "$1")
  /usr/bin/python3 - "$sanitized_field" <<'PY'
import re
import sys

text = re.sub(r"[`\\<>\[\]()]", " ", sys.argv[1])
text = re.sub(r"\s+", " ", text).strip()
sys.stdout.write(text[:200] or "-")
PY
}

oc_suggest_single_line() {
  printf '%s' "$1" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

oc_suggest_require_fingerprint() {
  fingerprint_value=$1
  case "$fingerprint_value" in
    *[!0-9a-f]*)
      oc_suggest_die "fingerprint must be exactly 64 lowercase hex characters: $fingerprint_value"
      ;;
  esac
  [ "${#fingerprint_value}" -eq 64 ] ||
    oc_suggest_die "fingerprint must be exactly 64 lowercase hex characters: $fingerprint_value"
}

oc_suggest_latest_report() {
  find "$OC_REPORT_DIR" -maxdepth 1 -type f -name '*.json' -print 2>/dev/null | LC_ALL=C sort | tail -n 1
}

oc_suggest_latest_report_night() {
  report_path=$1
  report_night=$(jq -r '.night_id // empty' "$report_path" 2>/dev/null || true)
  if [ -n "$report_night" ]; then
    printf '%s\n' "$report_night"
    return 0
  fi
  basename "$report_path" .json
}

oc_suggest_report_age_days() {
  report_night=$1
  suggest_today=${OC_SUGGEST_TODAY:-}
  if [ -z "$suggest_today" ]; then
    suggest_today=$(date '+%F')
  fi
  /usr/bin/python3 - "$suggest_today" "$report_night" <<'PY'
from datetime import date
import sys

today = date.fromisoformat(sys.argv[1])
report = date.fromisoformat(sys.argv[2])
print((today - report).days)
PY
}

oc_suggest_report_is_baseline_quiet() {
  jq -e '
    (.baseline == true)
    or (.quiet_mode? == "baseline")
    or (
      (.findings.new? | type == "array")
      and (.findings.baseline? | type == "array")
      and ((.findings.new | length) > 0)
      and ((.findings.new | length) == (.findings.baseline | length))
    )
  ' "$1" >/dev/null 2>&1
}

oc_suggest_report_is_migration_quiet() {
  jq -e '
    (.migration_mode == true)
    or (.fp_migration == true)
    or (.quiet_mode? == "migration")
    or (.migration? == true)
    or (.meta?.quiet_mode? == "migration")
  ' "$1" >/dev/null 2>&1
}

oc_suggest_issue_number_expr='if (.issue_number // .issue?.number // null) == null then "" else (.issue_number // .issue?.number | tostring) end'

oc_suggest_find_entry() {
  fp=$1
  jq -c --arg fp "$fp" '.findings[]? | select(.fingerprint == $fp)' "$OC_FINDINGS_PATH"
}

oc_suggest_find_issues_snapshot() {
  if [ -n "${OC_ISSUES_SNAPSHOT_PATH:-}" ]; then
    if [ -f "$OC_ISSUES_SNAPSHOT_PATH" ]; then
      printf '%s\n' "$OC_ISSUES_SNAPSHOT_PATH"
      return 0
    fi
    return 1
  fi
  snapshot_path="$OC_STATE_DIR/issues/family-os-open.json"
  [ -f "$snapshot_path" ] || return 1
  printf '%s\n' "$snapshot_path"
}

oc_suggest_snapshot_is_fresh() {
  snapshot_path=$1
  snapshot_night=$(jq -r '.night_id // empty' "$snapshot_path" 2>/dev/null || true)
  [ -n "$snapshot_night" ] || return 1
  snapshot_age_days=$(oc_suggest_report_age_days "$snapshot_night" 2>/dev/null) || return 1
  [ "$snapshot_age_days" -le "$OC_REPORT_MAX_AGE_DAYS" ]
}

oc_suggest_snapshot_has_open_stale_pointer() {
  snapshot_path=$1
  jq -e --arg family_repo "$OC_FAMILY_OS_REPO" '
    def entries:
      if type == "array" then .
      elif (.issues? | type == "array") then .issues
      else []
      end;
    def repo_name($item):
      ($item.repository?.full_name // $item.repo // $item.full_name // $item.repository // "");
    def label_names($item):
      [
        ($item.labels // [])[]? |
        if type == "object" then (.name // "") else tostring end
      ];
    any(
      entries[]?;
      ((.state // "open") != "closed")
      and ((repo_name(.) == "") or (repo_name(.) == $family_repo))
      and ((label_names(.) | index("stale-pointer")) != null)
    )
  ' "$snapshot_path" >/dev/null 2>&1
}

oc_suggest_finding_has_issue() {
  printf '%s\n' "$1" | jq -e "$oc_suggest_issue_number_expr | tostring | length > 0" >/dev/null 2>&1
}

oc_suggest_finding_issue_number() {
  printf '%s\n' "$1" | jq -r "$oc_suggest_issue_number_expr"
}

oc_suggest_finding_summary() {
  finding_json=$1
  claim=$(printf '%s\n' "$finding_json" | jq -r '.claim // ""')
  sanitized=$(oc_suggest_sanitize_claim "$claim")
  one_line=$(oc_suggest_single_line "$sanitized")
  printf '%s' "${one_line:0:140}"
}

oc_suggest_render_open_line() {
  finding_json=$1
  fp=$(printf '%s\n' "$finding_json" | jq -r '.fingerprint')
  check_id=$(printf '%s\n' "$finding_json" | jq -r '.check_id // "-"')
  repo=$(printf '%s\n' "$finding_json" | jq -r '.repo // "-"')
  file=$(printf '%s\n' "$finding_json" | jq -r '.file // .target // "-"')
  summary=$(oc_suggest_finding_summary "$finding_json")
  printf '%s\n' "- $fp [$check_id] $repo $file :: $summary"
}

oc_suggest_render_resolved_line() {
  finding_json=$1
  fp=$(printf '%s\n' "$finding_json" | jq -r '.fingerprint')
  issue_number=$(oc_suggest_finding_issue_number "$finding_json")
  repo=$(printf '%s\n' "$finding_json" | jq -r '.repo // "-"')
  summary=$(oc_suggest_finding_summary "$finding_json")
  printf '%s\n' "- $fp issue #$issue_number $repo :: $summary"
}

oc_suggest_render_self_health_line() {
  finding_json=$1
  fp=$(printf '%s\n' "$finding_json" | jq -r '.fingerprint')
  status=$(printf '%s\n' "$finding_json" | jq -r '.status // "-"')
  summary=$(oc_suggest_finding_summary "$finding_json")
  printf '%s\n' "- $fp [$status] :: $summary"
}

oc_suggest_update_findings_file() {
  jq_program=$1
  shift
  findings_dir=$(dirname "$OC_FINDINGS_PATH")
  tmp_path=$(mktemp "$findings_dir/.oc-suggest.XXXXXX")
  if jq "$jq_program" "$@" "$OC_FINDINGS_PATH" > "$tmp_path"; then
    mv "$tmp_path" "$OC_FINDINGS_PATH"
  else
    rm -f "$tmp_path"
    return 1
  fi
}

oc_suggest_promote_locked() {
  promoted_any=0
  for fp in "$@"; do
    [ -n "$fp" ] || continue
    oc_suggest_require_fingerprint "$fp"
    finding_json=$(oc_suggest_find_entry "$fp")
    [ -n "$finding_json" ] || oc_suggest_die "unknown fingerprint: $fp"
    check_id=$(printf '%s\n' "$finding_json" | jq -r '.check_id // ""')
    [ "$check_id" != "self-health" ] || oc_suggest_die "self-health findings are informational and cannot be promoted: $fp"
    is_baseline=$(printf '%s\n' "$finding_json" | jq -r '.baseline == true')
    [ "$is_baseline" = true ] || oc_suggest_die "fingerprint is not baseline: $fp"
    status=$(printf '%s\n' "$finding_json" | jq -r '.status // ""')
    [ "$status" = "open" ] || oc_suggest_die "baseline finding is not open: $fp"
    if oc_suggest_finding_has_issue "$finding_json"; then
      oc_suggest_die "baseline finding already has an issue: $fp"
    fi
    # shellcheck disable=SC2016
    oc_suggest_update_findings_file \
      --arg fp "$fp" \
      '.findings |= map(if .fingerprint == $fp then (.baseline = false) else . end)' ||
      oc_suggest_die "failed to promote $fp"
    promoted_any=1
    printf '%s\n' "promoted $fp"
  done
  [ "$promoted_any" -eq 1 ] || oc_suggest_die "--promote requires at least one fingerprint"
}

oc_suggest_build_issue_body() {
  finding_json=$1
  report_rel=$2
  fp=$(printf '%s\n' "$finding_json" | jq -r '.fingerprint')
  repo=$(oc_suggest_sanitize_field "$(printf '%s\n' "$finding_json" | jq -r '.repo // "-"')")
  check_id=$(oc_suggest_sanitize_field "$(printf '%s\n' "$finding_json" | jq -r '.check_id // "-"')")
  file=$(oc_suggest_sanitize_field "$(printf '%s\n' "$finding_json" | jq -r '.file // .target // "-"')")
  first_seen=$(oc_suggest_sanitize_field "$(printf '%s\n' "$finding_json" | jq -r '.first_seen // "-"')")
  claim=$(printf '%s\n' "$finding_json" | jq -r '.claim // ""')
  sanitized=$(oc_suggest_sanitize_claim "$claim")
  cat <<EOF
org-consistency observed a candidate drift that still needs a daytime decision.

- repo: \`$repo\`
- check: \`$check_id\`
- target: \`$file\`
- first seen: \`$first_seen\`
- report: \`$report_rel\`

\`\`\`text
$sanitized
\`\`\`

oc-fingerprint: $fp
EOF
}

oc_suggest_issue_title() {
  finding_json=$1
  repo=$(printf '%s\n' "$finding_json" | jq -r '.repo // "-"')
  check_id=$(printf '%s\n' "$finding_json" | jq -r '.check_id // "-"')
  summary=$(oc_suggest_finding_summary "$finding_json")
  printf '%s' "org-consistency: [$check_id] $repo: ${summary:0:90}"
}

oc_suggest_issue_writeback_locked() {
  fp=$1
  issue_repo=$2
  issue_number=$3
  issue_url=$4
  issued_at=$5
  # shellcheck disable=SC2016
  oc_suggest_update_findings_file \
    --arg fp "$fp" \
    --arg issue_repo "$issue_repo" \
    --arg issue_url "$issue_url" \
    --arg issued_at "$issued_at" \
    --argjson issue_number "$issue_number" \
    '.findings |= map(
      if .fingerprint == $fp then
        . + {
          issue_number: $issue_number,
          issue_repo: $issue_repo,
          issue_url: $issue_url,
          issue_filed_at: $issued_at
        }
      else
        .
      end
    )' || oc_suggest_die "failed to write back issue #$issue_number for $fp"
}

oc_suggest_with_lock() {
  lock_dir=$1
  shift
  lock_rc=0
  lock_acquire "$lock_dir" || lock_rc=$?
  if [ "$lock_rc" -ne 0 ]; then
    oc_suggest_die "state lock unavailable (rc=$lock_rc)"
  fi
  trap 'lock_release "$lock_dir" >/dev/null 2>&1 || true' EXIT
  "$@"
  lock_release "$lock_dir" >/dev/null 2>&1 || true
  trap - EXIT
}

oc_suggest_stale_pointer_state() {
  issues_snapshot=
  if issues_snapshot=$(oc_suggest_find_issues_snapshot); then
    if [ -n "$issues_snapshot" ] && [ -f "$issues_snapshot" ]; then
      if ! oc_suggest_snapshot_is_fresh "$issues_snapshot"; then
        printf '%s\n' "missing:$issues_snapshot"
        return 0
      fi
      if oc_suggest_snapshot_has_open_stale_pointer "$issues_snapshot"; then
        printf '%s\n' "present:$issues_snapshot"
        return 0
      fi
      printf '%s\n' "absent:$issues_snapshot"
      return 0
    fi
  fi
  printf '%s\n' 'missing:'
}

oc_suggest_list() {
  latest_report=$1
  report_night=$2
  report_age_days=$3
  report_rel=${latest_report#"$OC_STATE_DIR"/}
  baseline_quiet=false
  migration_quiet=false
  if oc_suggest_report_is_baseline_quiet "$latest_report"; then
    baseline_quiet=true
  fi
  if oc_suggest_report_is_migration_quiet "$latest_report"; then
    migration_quiet=true
  fi

  quiet_reason=
  if [ "$baseline_quiet" = true ]; then
    quiet_reason=baseline
  elif [ "$migration_quiet" = true ]; then
    quiet_reason=migration
  fi

  printf '%s\n' "Latest report: $report_rel ($report_night)"
  if [ "$report_age_days" -gt "$OC_REPORT_MAX_AGE_DAYS" ]; then
    printf '%s\n' "WARNING: latest report is ${report_age_days} days old (> ${OC_REPORT_MAX_AGE_DAYS})"
  fi
  if [ -n "$quiet_reason" ]; then
    printf '%s\n' "NOTE: candidate listing is suppressed on $quiet_reason nights."
  fi

  stale_pointer_state=$(oc_suggest_stale_pointer_state)
  stale_pointer_mode=${stale_pointer_state%%:*}
  stale_pointer_source=${stale_pointer_state#*:}

  open_count=0
  suppressed_count=0
  resolved_count=0
  missing_snapshot_note=false

  self_health_entries=$(jq -c '
    [.findings[]? | select(.check_id == "self-health")]
    | sort_by(.claim_kind // "", .fingerprint)
    | .[]
  ' "$OC_FINDINGS_PATH")
  printf '%s\n' ""
  printf '%s\n' "Self-health (informational)"
  if [ -z "$self_health_entries" ]; then
    printf '%s\n' "- none"
  else
    while IFS= read -r finding_json; do
      [ -n "$finding_json" ] || continue
      oc_suggest_render_self_health_line "$finding_json"
    done <<EOF
$self_health_entries
EOF
  fi

  open_entries=$(jq -c '
    [.findings[]? |
      select(.status == "open")
      | select(.check_id != "self-health")
      | select(.baseline != true)
      | select((if (.issue_number // .issue?.number // null) == null then "" else (.issue_number // .issue?.number | tostring) end) | length == 0)
    ] | sort_by(.repo // "", .check_id // "", .fingerprint)
    | .[]
  ' "$OC_FINDINGS_PATH")

  if [ -n "$quiet_reason" ]; then
    open_count=0
  else
    printf '%s\n' ""
    printf '%s\n' "Open candidates"
    if [ -z "$open_entries" ]; then
      printf '%s\n' "- none"
    else
      had_open=false
      while IFS= read -r finding_json; do
        [ -n "$finding_json" ] || continue
        check_id=$(printf '%s\n' "$finding_json" | jq -r '.check_id // ""')
        if [ "$check_id" = "OC-A" ] && [ "$stale_pointer_mode" = "present" ]; then
          suppressed_count=$((suppressed_count + 1))
          continue
        fi
        if [ "$check_id" = "OC-A" ] && [ "$stale_pointer_mode" = "missing" ]; then
          missing_snapshot_note=true
        fi
        oc_suggest_render_open_line "$finding_json"
        open_count=$((open_count + 1))
        had_open=true
      done <<EOF
$open_entries
EOF
      if [ "$had_open" = false ]; then
        printf '%s\n' "- none"
      fi
    fi
  fi

  if [ "$suppressed_count" -gt 0 ]; then
    printf '%s\n' ""
    printf '%s\n' "Suppressed open candidates: $suppressed_count (family-os stale-pointer issue is open)"
  fi
  if [ "$missing_snapshot_note" = true ]; then
    printf '%s\n' ""
    printf '%s\n' "NOTE: family-os issues snapshot is missing or stale; OC-A candidates were not suppressed."
  elif [ "$stale_pointer_mode" = "absent" ] && [ -n "$stale_pointer_source" ]; then
    :
  fi

  resolved_entries=$(jq -c '
    [.findings[]? |
      select(.status == "resolved-candidate")
      | select(.check_id != "self-health")
      | select((if (.issue_number // .issue?.number // null) == null then "" else (.issue_number // .issue?.number | tostring) end) | length > 0)
    ] | sort_by(.repo // "", .check_id // "", .fingerprint)
    | .[]
  ' "$OC_FINDINGS_PATH")

  if [ -z "$quiet_reason" ]; then
    printf '%s\n' ""
    printf '%s\n' "Resolved candidates"
    if [ -z "$resolved_entries" ]; then
      printf '%s\n' "- none"
    else
      had_resolved=false
      while IFS= read -r finding_json; do
        [ -n "$finding_json" ] || continue
        oc_suggest_render_resolved_line "$finding_json"
        resolved_count=$((resolved_count + 1))
        had_resolved=true
      done <<EOF
$resolved_entries
EOF
      if [ "$had_resolved" = false ]; then
        printf '%s\n' "- none"
      fi
    fi
  fi

  if [ -n "$quiet_reason" ]; then
    printf '%s\n' ""
    printf '%s\n' "Open candidates"
    printf '%s\n' "- suppressed by $quiet_reason night"
    printf '%s\n' ""
    printf '%s\n' "Resolved candidates"
    printf '%s\n' "- suppressed by $quiet_reason night"
  fi
}

oc_suggest_file_locked() {
  latest_report=$1
  report_night=$2
  shift 2

  baseline_quiet=false
  migration_quiet=false
  if oc_suggest_report_is_baseline_quiet "$latest_report"; then
    baseline_quiet=true
  fi
  if oc_suggest_report_is_migration_quiet "$latest_report"; then
    migration_quiet=true
  fi
  if [ "$baseline_quiet" = true ] || [ "$migration_quiet" = true ]; then
    oc_suggest_die "candidate filing is suppressed on the latest quiet night"
  fi

  stale_pointer_state=$(oc_suggest_stale_pointer_state)
  stale_pointer_mode=${stale_pointer_state%%:*}
  report_rel=${latest_report#"$OC_STATE_DIR"/}

  if [ "$stale_pointer_mode" = "missing" ]; then
    printf '%s\n' "NOTE: family-os issues snapshot is missing or stale; OC-A candidates were not suppressed."
  fi

  command -v gh >/dev/null 2>&1 || oc_suggest_die "gh is required for file"

  for fp in "$@"; do
    [ -n "$fp" ] || continue
    oc_suggest_require_fingerprint "$fp"
    finding_json=$(oc_suggest_find_entry "$fp")
    [ -n "$finding_json" ] || oc_suggest_die "unknown fingerprint: $fp"

    baseline=$(printf '%s\n' "$finding_json" | jq -r '.baseline == true')
    [ "$baseline" = false ] || oc_suggest_die "baseline finding must be promoted before filing: $fp"

    status=$(printf '%s\n' "$finding_json" | jq -r '.status // ""')
    [ "$status" = "open" ] || oc_suggest_die "finding is not open: $fp"

    if oc_suggest_finding_has_issue "$finding_json"; then
      oc_suggest_die "finding already has an issue: $fp"
    fi

    check_id=$(printf '%s\n' "$finding_json" | jq -r '.check_id // ""')
    [ "$check_id" != "self-health" ] || oc_suggest_die "self-health findings are informational and cannot be filed: $fp"
    if [ "$check_id" = "OC-A" ] && [ "$stale_pointer_mode" = "present" ]; then
      oc_suggest_die "OC-A filing is suppressed while family-os stale-pointer is open: $fp"
    fi

    title=$(oc_suggest_issue_title "$finding_json")
    body=$(oc_suggest_build_issue_body "$finding_json" "$report_rel")
    payload_tmp=$(mktemp "${TMPDIR:-/tmp}/oc-suggest-gh.XXXXXX")
    jq -n --arg title "$title" --arg body "$body" '{title:$title, body:$body}' > "$payload_tmp"
    response=$(
      gh api \
        --method POST \
        "repos/$OC_SUGGEST_REPO/issues" \
        --input "$payload_tmp"
    ) || {
      rm -f "$payload_tmp"
      oc_suggest_die "gh issue creation failed for $fp"
    }
    rm -f "$payload_tmp"
    issue_number=$(printf '%s\n' "$response" | jq -r '.number // empty')
    issue_url=$(printf '%s\n' "$response" | jq -r '.html_url // empty')
    case "$issue_number" in
      ''|*[!0-9]*) oc_suggest_die "gh response did not include a numeric issue number for $fp" ;;
    esac
    [ -n "$issue_url" ] || issue_url="https://github.com/$OC_SUGGEST_REPO/issues/$issue_number"
    issued_at=$(nightshift_iso_now)
    oc_suggest_issue_writeback_locked "$fp" "$OC_SUGGEST_REPO" "$issue_number" "$issue_url" "$issued_at"
    printf '%s\n' "filed $fp -> $OC_SUGGEST_REPO#$issue_number"
  done
}

mode=
promote_fps=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    list)
      [ -z "${mode:-}" ] || { oc_suggest_usage; exit 2; }
      mode='list'
      shift
      ;;
    file)
      [ -z "${mode:-}" ] || { oc_suggest_usage; exit 2; }
      mode='file'
      shift
      break
      ;;
    --state-dir)
      [ "$#" -ge 2 ] || { oc_suggest_usage; exit 2; }
      OC_STATE_DIR=$2
      shift 2
      ;;
    --report-max-age-days)
      [ "$#" -ge 2 ] || { oc_suggest_usage; exit 2; }
      OC_REPORT_MAX_AGE_DAYS=$2
      shift 2
      ;;
    --promote)
      [ "$#" -ge 2 ] || { oc_suggest_usage; exit 2; }
      promote_fps+=("$2")
      shift 2
      ;;
    *)
      oc_suggest_usage
      exit 2
      ;;
  esac
done

file_fps=()
if [ "${mode:-}" = file ]; then
  while [ "$#" -gt 0 ]; do
    file_fps+=("$1")
    shift
  done
fi

if [ -z "${mode:-}" ]; then
  if [ "${#promote_fps[@]}" -gt 0 ]; then
    mode='promote'
  else
    mode='list'
  fi
fi

OC_STATE_DIR=${OC_STATE_DIR:-"$REPO_ROOT/state/org-consistency"}
OC_REPORT_MAX_AGE_DAYS=${OC_REPORT_MAX_AGE_DAYS:-3}

case "$OC_STATE_DIR" in
  /*) ;;
  *) oc_suggest_die "OC_STATE_DIR must be absolute" ;;
esac
oc_suggest_require_positive_int "${OC_REPORT_MAX_AGE_DAYS:-}" OC_REPORT_MAX_AGE_DAYS

OC_STATE_DIR=$(cd -P "$OC_STATE_DIR" && pwd -P 2>/dev/null || true)
[ -n "$OC_STATE_DIR" ] || oc_suggest_die "OC_STATE_DIR is not accessible"
OC_REPORT_DIR=${OC_REPORT_DIR:-"$OC_STATE_DIR/report"}
OC_FINDINGS_PATH="$OC_STATE_DIR/findings.json"
OC_SUGGEST_REPO=${OC_SUGGEST_REPO:-caty-ai/alpha-nightshift-dev}

[ -d "$OC_REPORT_DIR" ] || oc_suggest_die "missing report directory: $OC_REPORT_DIR"
[ -f "$OC_FINDINGS_PATH" ] || oc_suggest_die "missing findings ledger: $OC_FINDINGS_PATH"
latest_report=$(oc_suggest_latest_report)
[ -n "$latest_report" ] || oc_suggest_die "no report JSON found in $OC_REPORT_DIR"
report_night=$(oc_suggest_latest_report_night "$latest_report")
report_age_days=$(oc_suggest_report_age_days "$report_night")
OC_FAMILY_OS_REPO=$(jq -r '
  ([.cells[]? | select(.check_id == "OC-A") | .repo][0]) // empty
' "$latest_report")
if [ -z "$OC_FAMILY_OS_REPO" ]; then
  OC_FAMILY_OS_REPO=$(jq -r '
    ([.findings[]? | select(.check_id == "OC-A") | .repo][0]) // empty
  ' "$OC_FINDINGS_PATH")
fi

case "$mode" in
  list)
    if [ "${#promote_fps[@]}" -gt 0 ]; then
      # Mutations share the lane's lock so findings.json cannot race a nightly run.
      oc_suggest_with_lock "$OC_STATE_DIR/.lock" oc_suggest_promote_locked "${promote_fps[@]}"
    fi
    oc_suggest_list "$latest_report" "$report_night" "$report_age_days"
    ;;
  promote)
    oc_suggest_with_lock "$OC_STATE_DIR/.lock" oc_suggest_promote_locked "${promote_fps[@]}"
    ;;
  file)
    [ "${#promote_fps[@]}" -eq 0 ] || oc_suggest_die "--promote cannot be combined with file"
    [ "${#file_fps[@]}" -gt 0 ] || oc_suggest_die "file requires at least one fingerprint"
    if [ "$report_age_days" -gt "$OC_REPORT_MAX_AGE_DAYS" ]; then
      printf '%s\n' "WARNING: latest report is ${report_age_days} days old (> ${OC_REPORT_MAX_AGE_DAYS})"
    fi
    oc_suggest_with_lock "$OC_STATE_DIR/.lock" oc_suggest_file_locked "$latest_report" "$report_night" "${file_fps[@]}"
    ;;
  *)
    oc_suggest_usage
    exit 2
    ;;
esac
